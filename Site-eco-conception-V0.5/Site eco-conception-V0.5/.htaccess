<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf|xml)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "private, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
